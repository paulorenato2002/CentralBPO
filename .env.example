# Copie para .env.local e preencha. NUNCA commitar o arquivo preenchido.

# Públicas (vão para o navegador; seguras porque o banco usa RLS)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Só no servidor (Vercel → Environment Variables). Dá acesso total ao banco.
SUPABASE_SERVICE_ROLE_KEY=

# Testes do backend: pasta com o esquema operacional base (baseline + migrations)
CENTRAL_BASE_DIR=

# Marca da instalação (opcional): logo e ícone em PNG, codificados em base64 (até 100 KB cada).
# Sem elas, a tela mostra só o nome "Central BPO".
CENTRAL_LOGO_PNG=
CENTRAL_ICONE_PNG=

# Chave da OpenAI usada pelo agente (api/agente/*). Só no servidor: nunca vai para o navegador.
# Na Vercel, cadastre como Secret e apenas em Production, igual à SUPABASE_SERVICE_ROLE_KEY.
OPENAI_API_KEY=
